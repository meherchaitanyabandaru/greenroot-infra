# Caddy terminates TLS for the API with automatic Let's Encrypt certificates
# (renewed by itself) and forwards to the API container.
{
	email {$ACME_EMAIL}
	# No trusted_proxies: clients connect directly, so Caddy ignores any
	# X-Forwarded-For they send and sets the real client address itself.
}

{$API_HOST} {
	encode zstd gzip

	# Largest upload the API accepts is 12 MB (HTTP_MAX_UPLOAD_BYTES).
	request_body {
		max_size 15MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy api:8080 {
		health_uri /health
		health_interval 10s
		# Caddy sets X-Forwarded-For to the real client; the API trusts it
		# only from the Docker network (TRUSTED_PROXIES).
	}

	log {
		output stdout
		format json
	}
}
